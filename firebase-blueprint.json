{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer purchase order in NAHID VAULT",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "maxLength": 64
        },
        "subtotal": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "tax": {
          "type": "number"
        },
        "shippingFee": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 64
        },
        "estimatedDelivery": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "subtotal", "total", "paymentMethod"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "User saved favorite product IDs",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "productIds": {
          "type": "array"
        }
      },
      "required": ["userId"]
    },
    "Product": {
      "title": "Product",
      "description": "Store luxury fashion product",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "price": {
          "type": "number"
        },
        "rating": {
          "type": "number"
        },
        "inStock": {
          "type": "boolean"
        }
      },
      "required": ["id", "title", "price"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer star rating and text review for a luxury product",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 128
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["id", "productId", "userName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Stores user completed checkout orders"
    },
    "/users/{userId}/wishlists/{wishlistId}": {
      "schema": {
        "$ref": "#/entities/Wishlist"
      },
      "description": "User specific wishlists"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Store fashion catalog items"
    },
    "/reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/Review"
      },
      "description": "Customer product reviews and ratings"
    }
  }
}
